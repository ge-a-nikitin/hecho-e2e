# Copy to `.env.e2e` for local runs. Every value below already has the same
# default in `support/env.ts` and `docker-compose.e2e.yml`, so an empty file is
# a working configuration; the file exists to make the knobs visible and to let
# one checkout point at a different stack.
#
# `.env.e2e` is git-ignored: never commit credentials, even fake ones.

# ---------------------------------------------------------------------------
# System under test (read-only, lives in another repository)
# ---------------------------------------------------------------------------

# Directory of the HECHO checkout. Relative paths resolve from this repository.
# `sut.lock.json` pins the commit the context artefacts were generated from.
SUT_DIR=../order-desk

# ---------------------------------------------------------------------------
# Origins of the ephemeral stack
# ---------------------------------------------------------------------------

# Browser-facing origin. Must match FRONTEND_ORIGIN of the API, otherwise
# Better Auth rejects the sign-in with MISSING_OR_NULL_ORIGIN.
BASE_URL=http://127.0.0.1:7200

# Origin the containers are built and configured for: the web bundle inlines it
# as VITE_API_URL, and the API uses it for FRONTEND_ORIGIN and BETTER_AUTH_URL.
# Change it together with BASE_URL and WEB_PORT, then rebuild (`pnpm stack:up`).
E2E_WEB_ORIGIN=http://127.0.0.1:7200

# API origin as the browser sees it. The web container proxies /api to the API,
# so the default stays same-origin and CORS never enters the picture.
API_URL=http://127.0.0.1:7200/api

# Published host ports used by docker-compose.e2e.yml.
WEB_PORT=7200
API_PORT=7201
POSTGRES_PORT=7202
S3_PORT=7203
SEAWEEDFS_ADMIN_PORT=7204

# ---------------------------------------------------------------------------
# Stack lifecycle
# ---------------------------------------------------------------------------

# auto   - start the compose stack when the API is unhealthy, keep it running
# attach - never start or stop anything; fail fast when the stack is down
# off    - do not check anything; for a stack you started and manage yourself
E2E_STACK=auto

# run   - reset the database once per run (global setup, before the setup project)
# never - keep the data; use for a shared or deployed environment
E2E_RESET=run

# A non-loopback BASE_URL destroys data with the devtools reset, so it is
# refused unless this is explicitly set to 1.
E2E_ALLOW_REMOTE=0

# Raise to see the stack script output while Playwright starts it.
E2E_STACK_VERBOSE=0

# ---------------------------------------------------------------------------
# Accounts and keys of the ephemeral stack
# ---------------------------------------------------------------------------

# Recreated by POST /api/devtools/reset from ADMIN_EMAIL / ADMIN_PASSWORD.
E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=e2e-admin-password

# Baseline customer and executor created by tests/setup/auth.setup.ts.
E2E_CUSTOMER_EMAIL=e2e.customer@example.test
E2E_EXECUTOR_EMAIL=e2e.executor@example.test
E2E_PASSWORD=e2e-account-password

# Must match DEVTOOLS_API_KEY of the API container and contain at least 32 bytes.
E2E_DEVTOOLS_API_KEY=e2e-devtools-key-at-least-32-characters

# ---------------------------------------------------------------------------
# Qase TestOps
# ---------------------------------------------------------------------------

# off      - local and pull-request runs, no network, no token needed
# testops  - publish a run; requires QASE_TESTOPS_API_TOKEN
QASE_MODE=off
# QASE_TESTOPS_API_TOKEN=
# QASE_TESTOPS_PROJECT=HECHO
# QASE_TESTOPS_API_HOST=qase.io
